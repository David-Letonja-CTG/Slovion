    "sl": {
      "name": {
        "value": "bela štorklja",
        "sources": [
          "np",
          "dopps"
        ]
      },
      "family": {
        "value": "štorklje (Ciconiidae)",
        "sources": [
          "dopps",
          "gbif"
        ]
      },
      "habitat": {
        "value": "Odprta kulturna krajina blizu vlažnih travnikov, rek in jezer. Ni plaha: gnezdo iz vej si zgradi blizu človeka, na strešnih slemenih, dimnikih, drogovih ali posebnih podstavkih.",
        "sources": [
          "np",
          "dopps"
        ]
      },
      "distribution": {
        "value": "Največ štorkelj gnezdi na severovzhodu Slovenije, v panonskem delu; štorklja je simbol Prekmurja. Na Rdečem seznamu je uvrščena med ranljive vrste.",
        "sources": [
          "wiki",
          "np"
        ]
      },
      "season": {
        "value": "Je selivka: prezimuje v tropski Afriki, vrača se zgodaj spomladi, na jug pa se lahko začne seliti že avgusta. Gnezdi od marca do junija.",
        "sources": [
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Dolga je od 95 do 110 cm, z razponom peruti od 180 do 220 cm.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Perje je belo, letalna peresa so črna; kljun in noge so rdeči.",
          "sources": [
            "np",
            "dopps"
          ]
        },
        {
          "value": "V letu ima iztegnjen vrat in dolge noge, ki segajo daleč za rep.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Redko se oglaša, rada pa »ropota« s kljunom.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Par se leto za letom vrača na isto gnezdo in ga dograjuje, zato lahko gnezdo tehta več kot 500 kg.",
          "sources": [
            "np",
            "dopps"
          ]
        }
      ]
    }
  },
