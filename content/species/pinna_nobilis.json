        "value": "Mehko sedimentno dno sredi morskih travnikov, v globinah od 0,5 do 60 m.",
        "sources": [
          "strunjan"
        ]
      },
      "distribution": {
        "value": "Je endemitska školjka Sredozemlja. Zaradi parazita, ki od leta 2016 povzroča množične pogine, se je populacija zmanjšala za več kot 90 %; je kritično ogrožena in zavarovana.",
        "sources": [
          "strunjan"
        ]
      },
      "season": {
        "value": "Lahko doživi več kot 40 let.",
        "sources": [
          "strunjan"
        ]
      },
      "characteristics": [
        {
          "value": "Je največja školjka v Sredozemskem morju: zraste do 120 cm.",
          "sources": [
            "strunjan"
          ]
        },
        {
          "value": "Iz njenih bisusnih niti so že stari Rimljani pridobivali »morsko svilo«.",
          "sources": [
            "strunjan"
          ]
        },
        {
          "value": "Na njej živijo pritrjene alge, spužve, ožigalkarji, mehkužci in mnogoščetinci.",
          "sources": [
            "strunjan"
          ]
        },
        {
          "value": "Ob njej pogosto najdemo ribe in rake.",
          "sources": [
            "strunjan"
          ]
        }
      ]
