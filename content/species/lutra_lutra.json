        ]
      },
      "distribution": {
        "value": "V Sloveniji živi okoli 120 vider, predvsem na Goričkem in Štajerskem. Je zavarovana in uvrščena na rdeči seznam.",
        "sources": [
          "wiki",
          "np"
        ]
      },
      "season": {
        "value": "Je vezana na vodo; pod vodo zdrži do štiri minute in plava s hitrostjo do 15 km na uro.",
        "sources": [
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Dolgo telo z močnim, stožčastim repom meri tudi več kot meter.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Gost temno rjav kožuh jo v vodi ohranja suho.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Med prsti kratkih nog ima plavalno kožico.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Glava je ploska, z majhnimi uhlji in čutilnimi dlakami okoli smrčka.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Hrani se večinoma z ribami, pa tudi z raki in dvoživkami.",
          "sources": [
