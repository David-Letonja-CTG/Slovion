      "habitat": {
        "value": "Plitva mokrišča, od sladkovodnih do slanih. V Sečoveljskih solinah gnezdi v solnih poljih ali na manjših nasipih, ki jih preraščajo slanuše, večinoma v kolonijah.",
        "sources": [
          "wiki",
          "kpss"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je redek, lokalno razširjen gnezdilec; gnezdenje je bilo potrjeno šele po letu 1990. Sečoveljske soline so njegovo najpomembnejše gnezdišče pri nas.",
        "sources": [
          "kpss"
        ]
      },
      "season": {
        "value": "V solinah ga opazujemo od marca do oktobra, največ od aprila do avgusta; evropski polojniki prezimujejo v Afriki.",
        "sources": [
          "kpss",
          "wiki"
        ]
      },
      "characteristics": [
        {
          "value": "Dolg je od 33 do 36 cm.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Rdečkasto rožnate noge merijo od 17 do 24 cm, skoraj dve tretjini telesne dolžine.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Kljun je raven in tanek skoraj kot igla.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Hrbet in peruti so črni, preostalo perje belo.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "V skupinah se oglaša z nosljatim »kek … kek … kek«.",
          "sources": [
            "wiki"
          ]
        }
      ]
    }
