      },
      "characteristics": [
        {
          "value": "V plečih je visok do 75 cm.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Poleti je svetlo rdečkasto rjav s temno progo po sredini hrbta, pozimi pa črno rjav.",
          "sources": [
            "gis"
          ]
        },
        {
          "value": "Rogove imata oba spola; so smolnato črni in na vrhu zakrivljeni.",
          "sources": [
            "lzs",
            "gis"
          ]
        },
        {
          "value": "Prek oči do gobca se mu na vsaki strani glave vleče široka temna proga.",
