        ]
      },
      "season": {
        "value": "Je selivka in znanilec pomladi: v Slovenijo se vrača aprila in maja, že sredi poletja pa odleti v Afriko južno od Sahare.",
        "sources": [
          "dopps"
        ]
      },
      "characteristics": [
        {
          "value": "Ima dolge, ozke, srpaste peruti.",
