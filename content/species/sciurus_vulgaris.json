          "gis"
        ]
      },
      "family": {
        "value": "Sciuridae",
        "sources": [
          "gbif"
        ]
      },
      "habitat": {
        "value": "Vse vrste gozdov, od iglastih in mešanih do listnatih; najbolj ji ustrezajo večje sklenjene gozdne površine.",
        "sources": [
          "lzs"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je razširjena od obale pa vse do gozdne meje.",
        "sources": [
          "tnp"
        ]
      },
      "season": {
        "value": "Aktivna je podnevi, najbolj zjutraj ob zori ter pozno popoldne in ob mraku. Zime ne prespi.",
        "sources": [
          "lzs",
          "tnp"
        ]
      },
      "characteristics": [
        {
          "value": "Trup je dolg od 22 do 25 cm, rep od 17 do 19 cm; tehta do 400 g.",
          "sources": [
            "gis",
            "lzs"
          ]
        },
        {
          "value": "Kožuh je rdeč do rjav, trebuh je vedno bel.",
          "sources": [
            "tnp"
          ]
        },
        {
          "value": "Na uhljih ima čopke dlak, ki so pozimi daljši.",
          "sources": [
            "tnp",
            "lzs"
          ]
        },
        {
          "value": "S košatim repom lovi ravnotežje, ko pleza in skače.",
          "sources": [
            "tnp",
            "lzs"
          ]
        },
        {
          "value": "Z ostrimi sekalci razdira storže smrek, borov in jelk, da pride do semen.",
          "sources": [
            "tnp"
          ]
        }
      ]
    }
  },
