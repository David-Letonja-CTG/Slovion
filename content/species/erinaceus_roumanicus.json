      "habitat": {
        "value": "Nižinska kulturna krajina, kjer se prepletajo gozdiči, žive meje, polja in travniki. Človeka se ne boji: v mraku ga srečamo tudi v mestnem parku ali na domačem vrtu.",
        "sources": [
          "np"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je splošno razširjen od nižin do približno 1000 m visoko. V starejših virih je naveden kot Erinaceus concolor.",
        "sources": [
          "wiki",
          "np"
        ]
      },
      "season": {
        "value": "Najbolj je aktiven ob mraku in ponoči; zimo prespi v hibernaciji.",
        "sources": [
          "wiki"
        ]
      },
      "characteristics": [
        {
          "value": "Ob nevarnosti se zvije v kroglo in naježi bodice.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Dolg je od 22,5 do 27,5 cm in tehta od 400 do 1100 g.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Ima vidno svetlejša prsa kot temno obarvani trebuh.",
          "sources": [
            "wiki"
          ]
        },
        {
          "value": "Hrani se z deževniki, hrošči in drugimi žuželkami, pajki in polži, rad pa poje tudi odpadlo sadje.",
          "sources": [
            "np",
            "wiki"
          ]
        }
      ]
