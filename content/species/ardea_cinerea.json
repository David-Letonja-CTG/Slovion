      "habitat": {
        "value": "Reke, jezera in mokrišča; plen lovi tudi na travnikih.",
        "sources": [
          "dopps",
          "np"
        ]
      },
      "distribution": {
        "value": "Pri nas je najpogostejša vrsta čaplje, ki jo zasledimo na skoraj vsaki večji reki ali mokrišču. V Sloveniji jo vidimo vse leto.",
        "sources": [
          "dopps",
          "np"
        ]
      },
      "season": {
        "value": "Gnezdi od februarja do aprila, najraje v krošnjah visokih dreves blizu jezera ali reke.",
        "sources": [
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Je velika ptica: z iztegnjenim vratom meri od 84 do 102 cm.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Zgoraj je pepelnato siva, spodaj sivo bela, na bokih ima črni lisi.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Nad rumenim očesom teče črna proga, ki se na tilniku konča s perjanico iz treh dolgih črnih peres.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Dolg in močan umazano rumen kljun ima obliko bodala.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Leti s skrčenim vratom in iztegnjenimi nogami.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Ure dolgo lahko nepremično čaka na bregu, nato bliskovito iztegne vrat in zgrabi ribo ali raka.",
          "sources": [
            "np"
          ]
        }
      ]
    }
