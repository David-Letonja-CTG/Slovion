          "nrp",
          "dopps",
          "drava"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je splošno razširjena gnezdilka nižin in gričevja; pri nas gnezdi od 20.000 do 30.000 parov.",
        "sources": [
          "dopps",
          "drava"
        ]
      },
      "season": {
        "value": "Je selivka, ki prezimuje v Afriki; k nam se vrne konec aprila ali v začetku maja.",
        "sources": [
          "nrp",
          "dopps",
          "drava"
        ]
      },
      "characteristics": [
        {
          "value": "Dolg je od 16 do 18 cm.",
          "sources": [
            "nrp"
          ]
        },
        {
          "value": "Samec ima sivo teme, črno obrazno masko ter rdečerjav hrbet in peruti.",
          "sources": [
            "dopps",
            "nrp"
          ]
        },
        {
          "value": "Ulovljen plen včasih natakne na trnje grmov ali na bodečo žico.",
          "sources": [
            "dopps",
            "drava"
          ]
        },
        {
          "value": "Gnezdi v gostem trnastem grmovju, na primer v šipku, glogu, črnem trnu ali robidi.",
          "sources": [
            "dopps",
            "drava"
          ]
        },
        {
          "value": "Plen opazuje s preže na vrhu grma ali plota; najraje lovi žuželke.",
