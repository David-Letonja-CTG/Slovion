      "habitat": {
        "value": "Negnojeni travniki, ki jih kosijo šele pozno, suhi ali močvirni; za gnezdenje potrebuje vlažne travnike.",
        "sources": [
          "dopps-tukalice",
          "dopps-kosec"
        ]
      },
      "distribution": {
        "value": "V Sloveniji gnezdi med 300 in 400 koscev, največ na Ljubljanskem barju, sledi Cerkniško jezero. Prezimuje v afriških savanah in stepah.",
        "sources": [
          "dopps-kosec",
          "dopps-tukalice"
        ]
      },
      "season": {
        "value": "Pri nas je od maja do avgusta, ko tudi gnezdi.",
        "sources": [
          "dopps-tukalice",
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Je srednje velik ptič, dolg od 27 do 30 cm.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Čez dan se skriva v gosti travi; če ga splašimo, ne odleti daleč.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "V letu pokaže cimetno rjavo zgornjo stran kril in progast hrbet, noge pa mu bingljajo.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Samci ponoči glasno kličejo »krrrek – krrrek«, kar spominja na brušenje kose; klic se sliši do 1 km daleč.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Gnezdo zgradi na tleh nepokošenih travnikov.",
          "sources": [
            "np"
          ]
        }
      ]
    }
