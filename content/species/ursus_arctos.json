      "habitat": {
        "value": "Listnati, iglasti in mešani gozdovi v nižinah in gorah.",
        "sources": [
          "lzs"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je najpogostejši v bukovo-jelovih gozdovih dinarskega visokogorskega krasa.",
        "sources": [
          "lzs"
        ]
      },
      "season": {
        "value": "Je predvsem nočna žival, a ga neredko vidimo tudi podnevi. Zimo prespi, vendar to ni pravo zimsko spanje.",
        "sources": [
          "lzs"
        ]
      },
      "characteristics": [
        {
          "value": "Samci so dolgi od 161 do 257 cm, samice od 120 do 200 cm.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Kožuh je v osnovi rjav, lahko pa je tudi svetel z rumenkastimi toni ali temen, črno rjav.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Pri hoji stopa po celotnem podplatu.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Oči so drobne, uhlji kratki in zaokroženi, rep pa kratek in skrit v kožuhu.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Je vsejed: hrani se z glivami, gozdnimi plodovi, deli rastlin, nevretenčarji, glodavci in mrhovino.",
          "sources": [
            "lzs"
          ]
        }
      ]
    }
