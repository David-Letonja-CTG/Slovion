      "habitat": {
        "value": "Topla kulturna krajina, kjer se pašniki, njive in sadovnjaki prepletajo z mejicami; najraje ima stare visokodebelne sadovnjake. Gnezdi v duplu starega sadnega drevesa ali v vrzeli v zidu.",
        "sources": [
          "np"
        ]
      },
      "distribution": {
        "value": "V Sloveniji je pogosta poletna vrsta.",
        "sources": [
          "wiki"
        ]
      },
      "season": {
        "value": "Je selivka: k nam se vrne spomladi, največkrat aprila, septembra pa odleti v Afriko.",
        "sources": [
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Velika je kot kos, a ima dolg, ozek, navzdol ukrivljen kljun.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Glava, vrat in prsi so rožnato oker, krila in rep pa črni z belimi progami.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Na glavi ima perjanico s črnimi konci, ki jo razpre predvsem ob pristanku.",
          "sources": [
            "np",
            "wiki"
          ]
        },
        {
          "value": "Oglaša se z daleč slišnim »up-up-up«.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Hrano išče podnevi na tleh: kobilice, bramorje, hrošče in njihove ličinke.",
          "sources": [
            "np"
          ]
        }
      ]
