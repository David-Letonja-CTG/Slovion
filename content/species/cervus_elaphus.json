      "habitat": {
        "value": "Veliki sklenjeni bukovo-jelovi in mešani gozdovi, kjer se prepletata gozd in travnik.",
        "sources": [
          "tnp"
        ]
      },
      "distribution": {
        "value": "Pri nas živi v listopadnih in mešanih gozdovih, v gorah do drevesne meje; največ ga je v gorskih bukovo-jelovih gozdovih.",
        "sources": [
          "gis",
          "tnp"
        ]
      },
      "season": {
        "value": "Večinoma je aktiven ponoči in v mraku. Čas parjenja, ruk, je septembra in oktobra.",
        "sources": [
          "gis",
          "tnp"
        ]
      },
      "characteristics": [
        {
          "value": "Trup je dolg od 1,65 do 2,5 m; tehta od 100 do 340 kg.",
          "sources": [
            "gis"
          ]
        },
        {
          "value": "Poleti je rdečkast, pozimi sivo rjav; zrcalo je rumenkasto.",
          "sources": [
            "gis"
          ]
        },
        {
          "value": "Samci imajo razvejano rogovje, ki vsako leto marca ali aprila odpade in znova zraste.",
          "sources": [
            "tnp"
          ]
        },
        {
          "value": "Košute rogovja nimajo.",
          "sources": [
            "tnp"
          ]
        },
        {
          "value": "Mladiči, teleta, so belo pegasti.",
          "sources": [
            "gis",
            "tnp"
          ]
        }
      ]
    }
