          "lzs",
          "tnp"
        ]
      },
      "characteristics": [
        {
          "value": "Je eden največjih glodavcev; odrasel tehta do 8 kg.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Dlaka je rumenkasto rjava, glava siva, konica kratkega repa skoraj črna.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Glodači so oranžni.",
          "sources": [
            "lzs"
          ]
        },
        {
          "value": "Ob nevarnosti z glasnim piskom opozori vso skupnost.",
          "sources": [
            "lzs",
            "tnp"
          ]
        },
        {
          "value": "Z močnimi kremplji koplje rove; brlog leži od 2 do 5 m pod površjem.",
