        ]
      },
      "season": {
        "value": "Na toplejših območjih leti od konca aprila do oktobra, v hladnejših nekoliko krajši čas.",
        "sources": [
          "np"
        ]
      },
      "characteristics": [
        {
          "value": "Je eden naših največjih enakokrilih kačjih pastirjev: dolg je okoli 45 mm, razpon kril meri okoli 6 cm.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Samec ima kovinsko modro telo, ki se preliva v kovinsko zeleno.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Samec ima na krilih širok temno moder pas.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Samica je kovinsko zelena, krila pa ima prozorna z rahlim zelenkastim pridihom.",
          "sources": [
            "np"
          ]
        },
        {
          "value": "Samci samicam pred parjenjem dvorijo z razkazovanjem.",
          "sources": [
